# Firebase (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# IA (Gemini) - chat en lenguaje natural
# Obtén una clave gratis en https://aistudio.google.com/apikey
# Restringe la clave por "Sitios web (HTTP referrers)" a tus dominios de Firebase Hosting.
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.1-flash-lite

# Firebase (Functions/Genkit - server)
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=
GENKIT_ENV=dev

# Google Calendar (OAuth web, lado cliente)
# Crea el "ID de cliente de OAuth" en https://console.cloud.google.com/apis/credentials
# (tipo "App web") y autoriza estos orígenes JavaScript + este redirect:
#   - Orígenes: https://cashmet-b70e4.web.app, https://cashmet-b70e4.firebaseapp.com, http://localhost:5173
#   - Redirect: https://cashmet-b70e4.web.app (y http://localhost:5173 para dev)
VITE_GOOGLE_CALENDAR_CLIENT_ID=

# FCM Web Push VAPID
VITE_FCM_VAPID_KEY=
FCM_VAPID_PRIVATE_KEY=

# App
VITE_APP_NAME=CashMet
VITE_APP_VERSION=0.1.0
